{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/grimoire-codex/community-add-ons/main/schema/addon.schema.json",
  "title": "Grimoire add-on manifest",
  "description": "A single Grimoire community add-on. See docs/format.md for the authoring reference.",
  "type": "object",
  "required": ["id", "name", "version", "kind"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable unique identifier. Must match the containing directory name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version. Bump on every change so installs can detect updates."
    },
    "kind": {
      "enum": ["scraper", "character-importer"],
      "description": "'scraper' fills in game system or book metadata; 'character-importer' reads characters from another tool. See docs/format.md and docs/character-importers.md."
    },
    "target": {
      "enum": ["game-system", "book", "character"],
      "default": "game-system",
      "description": "Which Grimoire entity this add-on populates. Determines which map fields are valid. A character importer's target is always 'character' and may be omitted."
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "author": {
      "type": "string",
      "maxLength": 120,
      "description": "Who wrote this add-on. A GitHub username (e.g. 'hunter-read', or '@hunter-read') links to that profile in Grimoire; any other text is credited without a link. Distinct from 'attribution', which credits the upstream data source."
    },
    "attribution": {
      "type": "string",
      "description": "Credit line shown in the UI next to fetched data."
    },
    "grimoire_min_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "object",
      "description": "Where the data comes from. Omit when the add-on uses a script.",
      "required": ["url", "format"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "The JSON endpoint. Contains {query} for a per-query search endpoint; omit it for a whole-catalogue file fetched once and cached."
        },
        "format": {
          "enum": ["json"]
        },
        "cache_ttl": {
          "type": "integer",
          "minimum": 0,
          "default": 3600,
          "description": "Seconds to reuse a cached response before re-fetching."
        },
        "user_agent": {
          "type": "string",
          "description": "{version} is substituted with the running Grimoire version."
        }
      }
    },
    "script": {
      "type": "object",
      "description": "Python escape hatch for sources YAML cannot express. Requires explicit user approval to run.",
      "required": ["entry"],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.py$",
          "description": "Script filename, relative to the add-on directory."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 60
        }
      }
    },
    "records": {
      "type": "object",
      "description": "How to find the list of records inside the fetched document.",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "default": "$",
          "description": "'$' for a bare top-level array, or a dotted path such as 'data.systems'."
        },
        "skip_when": {
          "type": "object",
          "required": ["field", "equals"],
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "equals": {}
          }
        }
      }
    },
    "detail": {
      "type": "object",
      "description": "A second request for the chosen record's full data, when search returns trimmed summaries. When present, `map` runs against this response.",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "\\{identity\\}",
          "description": "Per-item endpoint. Must contain the {identity} placeholder."
        },
        "root": {
          "type": "string",
          "default": "$"
        }
      }
    },
    "search": {
      "type": "object",
      "description": "How an incoming query is matched against records.",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "default": 1.0
              },
              "strategy": {
                "enum": ["fuzzy", "exact", "contains"],
                "default": "fuzzy"
              }
            }
          }
        },
        "min_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "label": {
          "$ref": "#/$defs/valueSpec"
        },
        "identity": {
          "$ref": "#/$defs/valueSpec"
        },
        "url": {
          "$ref": "#/$defs/valueSpec"
        },
        "identity_pattern": {
          "type": "string",
          "maxLength": 200,
          "description": "Regex with exactly one capture group, extracting an identity from a pasted source URL. Enables the \"paste a link or ID\" input. Keep it simple — nested quantifiers are rejected."
        }
      }
    },
    "map": {
      "type": "object",
      "description": "Maps source fields onto Grimoire fields. Which keys are valid depends on `target`; Grimoire rejects a manifest that maps a field its target does not have.",
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/$defs/mapping"
        },
        "year": {
          "$ref": "#/$defs/mapping"
        },
        "license": {
          "$ref": "#/$defs/mapping"
        },
        "genres": {
          "$ref": "#/$defs/mapping"
        },
        "tags": {
          "$ref": "#/$defs/mapping"
        },
        "urls": {
          "$ref": "#/$defs/mapping"
        },
        "publishers": {
          "$ref": "#/$defs/mapping"
        },
        "system_family": {
          "$ref": "#/$defs/mapping"
        },
        "parent_system": {
          "$ref": "#/$defs/mapping"
        },
        "edition": {
          "$ref": "#/$defs/mapping"
        },
        "dice_materials": {
          "$ref": "#/$defs/mapping"
        },
        "character_builder_urls": {
          "$ref": "#/$defs/mapping"
        },
        "title": {
          "$ref": "#/$defs/mapping"
        },
        "authors": {
          "$ref": "#/$defs/mapping"
        },
        "artists": {
          "$ref": "#/$defs/mapping"
        },
        "publisher": {
          "$ref": "#/$defs/mapping"
        },
        "publisher_url": {
          "$ref": "#/$defs/mapping"
        },
        "isbn": {
          "$ref": "#/$defs/mapping"
        },
        "product_code": {
          "$ref": "#/$defs/mapping"
        },
        "version": {
          "$ref": "#/$defs/mapping"
        },
        "language": {
          "$ref": "#/$defs/mapping"
        },
        "month": {
          "$ref": "#/$defs/mapping"
        },
        "day": {
          "$ref": "#/$defs/mapping"
        }
      }
    },
    "importer": {
      "$ref": "#/$defs/importer"
    }
  },
  "anyOf": [
    {
      "required": ["source"]
    },
    {
      "required": ["script"]
    },
    {
      "required": ["importer"]
    }
  ],
  "$defs": {
    "valueSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "template": {
          "type": "string",
          "description": "Literal text with {field} placeholders. '{identity}' refers to the resolved identity value."
        },
        "transform": {
          "$ref": "#/$defs/transform"
        }
      },
      "anyOf": [
        {
          "required": ["from"]
        },
        {
          "required": ["template"]
        }
      ]
    },
    "transform": {
      "description": "A named transform, or a list applied in order.",
      "oneOf": [
        {
          "$ref": "#/$defs/transformName"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformName"
          },
          "minItems": 1
        }
      ]
    },
    "importerTransform": {
      "description": "A named transform, or a list applied in order. Importers may also use 'modifier' (an ability score as its modifier) and 'signed' (a number with its sign).",
      "oneOf": [
        {
          "$ref": "#/$defs/importerTransformName"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/importerTransformName"
          },
          "minItems": 1
        }
      ]
    },
    "importerTransformName": {
      "anyOf": [
        {
          "$ref": "#/$defs/transformName"
        },
        {
          "enum": ["modifier", "signed"]
        }
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^\\s*[$@]",
      "maxLength": 500,
      "description": "A JSONPath: '$' for the document root, '@' for the current item. See docs/character-importers.md#paths."
    },
    "importerValue": {
      "type": "object",
      "additionalProperties": false,
      "description": "How to read one value: exactly one of 'from', 'template' or 'value'.",
      "properties": {
        "from": {
          "description": "A path, or several whose results are concatenated.",
          "oneOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/path"
              },
              "minItems": 1
            }
          ]
        },
        "template": {
          "type": "string",
          "description": "Text with {$.path} or {@.path} placeholders."
        },
        "value": {
          "description": "A constant."
        },
        "transform": {
          "$ref": "#/$defs/importerTransform"
        },
        "values": {
          "type": "object",
          "description": "A lookup from the source's vocabulary to the sheet's. A value with no entry passes through."
        },
        "keys": {
          "type": "boolean",
          "default": false,
          "description": "Yield the member names a path selects rather than their values."
        },
        "join": {
          "type": "string",
          "maxLength": 20,
          "description": "Join every value into one string, dropping repeats."
        }
      },
      "oneOf": [
        {
          "required": ["from"]
        },
        {
          "required": ["template"]
        },
        {
          "required": ["value"]
        }
      ]
    },
    "importerValueOrPath": {
      "oneOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "$ref": "#/$defs/importerValue"
        }
      ]
    },
    "importerField": {
      "description": "One sheet field's mapping: a path, a mapping object, or a list of them whose values are concatenated.",
      "oneOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "$ref": "#/$defs/importerFieldObject"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/path"
              },
              {
                "$ref": "#/$defs/importerFieldObject"
              }
            ]
          }
        }
      ]
    },
    "importerFieldObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/importerValue/properties/from"
        },
        "template": {
          "type": "string"
        },
        "value": {},
        "transform": {
          "$ref": "#/$defs/importerTransform"
        },
        "values": {
          "type": "object"
        },
        "keys": {
          "type": "boolean"
        },
        "join": {
          "type": "string",
          "maxLength": 20
        },
        "name": {
          "type": "string",
          "pattern": "^\\s*@",
          "description": "Catalog fields over objects: the path to each object's name. Defaults to '@.name'."
        },
        "description": {
          "type": "string",
          "pattern": "^\\s*@",
          "description": "Catalog fields over objects: the path to each object's description, kept when nothing installed matches."
        },
        "match": {
          "type": "object",
          "description": "Catalog fields: properties an installed entry must also have to count as a match.",
          "additionalProperties": {
            "$ref": "#/$defs/importerValueOrPath"
          }
        },
        "columns": {
          "type": "object",
          "description": "List fields: each column key mapped to a path relative to each row.",
          "additionalProperties": {
            "$ref": "#/$defs/importerValueOrPath"
          }
        }
      },
      "oneOf": [
        {
          "required": ["from"]
        },
        {
          "required": ["template"]
        },
        {
          "required": ["value"]
        }
      ]
    },
    "importer": {
      "type": "object",
      "description": "Character importers only: what they read, and how it maps onto a sheet. See docs/character-importers.md.",
      "required": ["sheet"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["extensions"]
        },
        {
          "required": ["detect"]
        },
        {
          "required": ["url"]
        }
      ],
      "properties": {
        "sheet": {
          "type": "string",
          "pattern": "^[a-z0-9]+([-_][a-z0-9]+)*$",
          "description": "The id of the character sheet the result is built on."
        },
        "extensions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9][a-z0-9._-]{0,30}$"
          },
          "description": "File types this importer reads, lowercase with the dot."
        },
        "detect": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/path"
          },
          "description": "Paths that must all select something for a file to be recognised."
        },
        "url": {
          "type": "object",
          "required": ["pattern"],
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string",
              "maxLength": 200,
              "description": "A regex that recognises a pasted link and captures the character's id in its one group."
            },
            "fetch": {
              "type": "string",
              "pattern": "^https?://.*\\{identity\\}",
              "description": "The JSON endpoint to read the character from. Required unless the importer has a script."
            },
            "hint": {
              "type": "string",
              "maxLength": 200,
              "description": "An example link, shown as the paste box's placeholder."
            },
            "user_agent": {
              "type": "string"
            }
          }
        },
        "name": {
          "$ref": "#/$defs/importerValueOrPath"
        },
        "portrait": {
          "$ref": "#/$defs/importerValueOrPath"
        },
        "fields": {
          "type": "object",
          "description": "Sheet field name to mapping.",
          "additionalProperties": {
            "$ref": "#/$defs/importerField"
          }
        },
        "inputs": {
          "type": "array",
          "maxItems": 5,
          "description": "Fields the import dialog shows - an API key, say. The values go to the importer's script for that one import and are never stored. Needs a script.",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "help": {
                "type": "string",
                "maxLength": 300
              },
              "secret": {
                "type": "boolean",
                "default": false,
                "description": "Show a password field rather than a text field."
              },
              "required": {
                "type": "boolean",
                "default": false,
                "description": "Ask for it before the script runs. Leave false for something only some imports need, and ask for it from the script with needs_input."
              },
              "when": {
                "enum": ["always", "file", "link"],
                "default": "always",
                "description": "Which kind of import it belongs to."
              }
            }
          }
        }
      }
    },
    "transformName": {
      "enum": [
        "slugify",
        "titlecase",
        "upper",
        "lower",
        "trim",
        "upper_dice",
        "strip_query",
        "strip_html"
      ]
    },
    "mapping": {
      "description": "A single mapping, or a list of them (used to build multi-entry link lists).",
      "oneOf": [
        {
          "$ref": "#/$defs/mappingEntry"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingEntry"
          },
          "minItems": 1
        }
      ]
    },
    "mappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "Entry label, for link-list targets (urls, character_builder_urls)."
        },
        "split": {
          "type": "string",
          "description": "Split a scalar string on this separator to produce a list."
        },
        "when_present": {
          "type": "boolean",
          "default": false,
          "description": "Skip this entry entirely when the source value is missing or empty."
        },
        "as": {
          "enum": ["link_list"],
          "description": "'link_list' wraps scalars as [{name, url}] for the publishers field."
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "select": {
          "$ref": "#/$defs/select"
        },
        "pluck": {
          "$ref": "#/$defs/pluck"
        },
        "first": {
          "type": "boolean",
          "default": false,
          "description": "Keep only the first value when the path yields several."
        }
      },
      "anyOf": [
        {
          "required": ["from"]
        },
        {
          "required": ["template"]
        }
      ]
    },
    "select": {
      "type": "object",
      "description": "Narrow a list of objects to those matching on a field \u2014 e.g. one entry per language, or one branch of a flat taxonomy.",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "equals": {},
        "in": {
          "type": "array",
          "items": {},
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": ["equals"]
        },
        {
          "required": ["in"]
        }
      ]
    },
    "pluck": {
      "type": "object",
      "description": "Read one value out of each object kept by an outer `select`. Use when the source nests a second repeated list inside each entry.",
      "required": ["from"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "select": {
          "$ref": "#/$defs/select"
        },
        "first": {
          "type": "boolean",
          "default": false
        },
        "transform": {
          "$ref": "#/$defs/transform"
        }
      }
    }
  }
}
